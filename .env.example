# Discord Developer Portal > Bot에서 발급. 채팅에 공유하지 마세요.
DISCORD_TOKEN=
# Developer Portal > General Information > Application ID
DISCORD_APPLICATION_ID=
# 테스트 서버 ID. 개발자 모드를 켠 뒤 서버 우클릭 > 서버 ID 복사
DISCORD_GUILD_ID=
# 선택. 기본값은 ./data/bot.sqlite
DATABASE_PATH=./data/bot.sqlite

# 개인 API 키 저장용 서버 암호화 키. 32바이트 무작위 값의 base64 표현.
# 한 번 생성해 보관하고 재배포 시 유지하세요. 바꾸면 기존 개인 키를 복호화할 수 없습니다.
# 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
API_KEY_ENCRYPTION_KEY=
